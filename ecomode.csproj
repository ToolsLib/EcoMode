<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

<ItemGroup>
  <EmbeddedResource Include="Assets\app_simplified.ico" />
  <EmbeddedResource Include="profiles\*.json" LogicalName="ecomode.profiles.%(Filename)%(Extension)" />
  <Compile Remove="tests\**\*.cs" />
  <Compile Remove="artifacts\**\*.cs" />
  <InternalsVisibleTo Include="EcoMode.RegressionTests" />
</ItemGroup>


</Project>
